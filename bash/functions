reload_bashrc() {
    source $HOME/dotfiles/.bashrc
}

zf() {
  local selected
  selected=$(fzf) || return   # run fzf, quit if nothing selected
  "$@" "$selected"            # run whatever CLI you pass as arguments
}

zd() {
  local dir
  dir=$(find . -type d | fzf) || return
  cd "$dir"
  "$@" .
}

zcd() {
  local dir
  dir=$(find . -type d 2>/dev/null | fzf) || return
  cd "$dir"
}

git_cc() {
    git config --global credential.helper manager-core
}

gacp() {
    git add . && git commit -m "$1" && git push origin main
}
