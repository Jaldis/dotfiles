nvimconf() {
    cd $HOME/dotfiles/nvim
}

dotfiles() {
    cd $HOME/dotfiles
}

reload_bashrc() {
    source $HOME/dotfiles/bash/bashrc
}

nvimlazy() {
    export XDG_CONFIG_HOME=~/.config
}

zf() {
  local selected
  selected=$(fzf) || return   # run fzf, quit if nothing selected
  "$@" "$selected"            # run whatever CLI you pass as arguments
}

